    "native:mac:approve": "node native/notarize-mac.cjs Release"
  },
  "dependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "vite": "*",
    "typescript": "*",
    "@types/react": "*",
    "@types/react-dom": "*"
  }
}
